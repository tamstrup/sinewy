    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "ag-grid-community": "^36.1.0",
    "ag-grid-enterprise": "^36.1.0",
    "sin": "file:../../sin",
    "sinewy": "file:.."
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
