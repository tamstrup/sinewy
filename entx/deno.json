{
  "lock": true,
  "exclude": ["+build/", "node_modules/"],
  "fmt": {
    "lineWidth": 100,
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env=PORT --watch api/main.ts",
    "start": "deno run --allow-net --allow-env=PORT api/main.ts",
    "test": "deno test"
  }
}
